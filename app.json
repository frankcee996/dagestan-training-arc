{
  "expo": {
    "name": "2-3 Years: Dagestan",
    "slug": "dagestan-training-arc",
    "scheme": "dagestan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mascot.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "splash": {
      "image": "./assets/mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "android": {
      "package": "com.dagestan.trainingarc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mascot.png",
        "backgroundColor": "#050505"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4fd74346-91e5-4565-9358-ce14862a75a9"
      }
    }
  }
}
